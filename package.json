{
  "name": "the-typescript-farmer",
  "bin": "./scripts/build.ts",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.ts",
    "build:watch": "node scripts/build.ts --watch",
    "coverage": "vitest run --coverage",
    "dev": "node scripts/build.ts --watch",
    "format": "node scripts/with-saves.ts oxfmt",
    "lint": "node scripts/with-saves.ts oxlint",
    "lint:fix": "node scripts/with-saves.ts oxlint --fix",
    "test": "vitest",
    "types": "tsc -b"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "oxc-parser": "^0.152.0",
    "py-ast": "^1.16.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "5.0.2",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "packageManager": "yarn@4.12.0"
