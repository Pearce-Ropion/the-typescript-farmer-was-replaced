.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Whether you use PnP or not, the node_modules folder is often used to store
# build artifacts that should be gitignored
node_modules

# Generated Python output of the build script
builds

# Your saves' TypeScript is ignored by default. Remove or comment out the next line
# if you want to version control your saves yourself.
saves/*
# Except this explanation of the directory, so that it exists in a fresh checkout.
!saves/README.md

# What the game prints (output.txt) is copied into the logs directory of a save while a build is watching.
# This stays ignored when you commit your saves in your fork.
saves/*/logs/

# Test coverage reports
coverage
