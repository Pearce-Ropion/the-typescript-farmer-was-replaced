{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "avoid",
  "singleQuote": true,
  "trailingComma": "all",
  "sortPackageJson": {
    "sortScripts": true
  },
  "sortImports": {
    "ignoreCase": false,
    "newlinesBetween": true,
    "groups": [["side_effect"], ["builtin"], ["external"], ["parent"], ["sibling"], ["index"]]
  }
}
